# ── Telegram Bots ──────────────────────────
# Create bots at https://t.me/BotFather
# Each bot posts to one YouTube channel
BOT1_TELEGRAM_TOKEN=your_alishabitch_bot_token
BOT2_TELEGRAM_TOKEN=your_nightnight_bot_token
BOT3_TELEGRAM_TOKEN=your_guardianangle_bot_token

# ── Telegram Backup Channel ────────────────
# Bot token that has admin access to a private Telegram channel
# Processed videos are stored here after YouTube upload
TELEGRAM_CHANNEL_BOT_TOKEN=your_channel_bot_token
TELEGRAM_CHANNEL_ID=-1001234567890

# ── AI Content Generation ──────────────────
# NVIDIA API key (primary) — https://build.nvidia.com
NVIDIA_API_KEY=your_nvidia_api_key_here

# Grok API key (fallback) — https://x.ai/grok
GROK_API_KEY=your_grok_api_key_here
