# Telegram bot token (get from @BotFather on Telegram)
# Required for --telegram mode
TELEGRAM_TOKEN=your_telegram_bot_token_here

# NVIDIA API key for AI-generated captions, CTAs, hashtags (primary)
# Get from https://build.nvidia.com/explore/discover
NVIDIA_API_KEY=your_nvidia_api_key_here

# Grok API key for AI-generated YouTube metadata (fallback if NVIDIA unavailable)
GROK_API_KEY=your_grok_api_key_here
